.venv/
__pycache__/
*.pyc
# regenerated by the solver (figures, GIFs)
rmi_output_gpu/
# benchmark outputs: keep plots, CSV and JSON; skip bulky frame data
results/**/vtk/
results/**/frames.npz
results/rmi_mhd_quick/
results/*_quick/
results/phase1_checks/
results/phase2_checks/
results/phase3_checks/
results/shot_fitting/runs/

# generated material tables (python tools/generate_sesame.py)
tables/

# trained neural-operator weights (python tools/train_fno_radiation.py)
results/fno/*.npz

# native extension, built by tools/build_core.py
aegis/aegis_core*.pyd
aegis/aegis_core*.so

# CHIANTI line files fetched on demand (MB per ion), not bundled
aegis/data/atomic/chianti/
